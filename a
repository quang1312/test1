    @Slot()
    def refreshAnalytics(self):
        """Nút Refresh thủ công: bỏ cache của key hiện tại, lấy dữ liệu mới."""
        self._refresh(force=True)

    def _cache_key(self, analytics_filter: AnalyticsFilter, grid_id: int) -> tuple:
        # assetType KHÔNG nằm trong key: dữ liệu không đổi theo asset, chỉ KPI/khuyến nghị lọc lại
        bucket = int(time.time() // _CACHE_BUCKET_SECONDS)
        return (grid_id, analytics_filter.timeRange, analytics_filter.fromTime, analytics_filter.toTime, bucket)

    def _refresh(self, background: bool = False, force: bool = False):
        if not self._filter.valid:
            self._set_error(self._filter.message)
            return
        if self._builder is None:
            self._refresh_simulator()
            return
        if not background:
            self._set_loading(True)   # poll nền không bật "UPDATING" để khỏi nhấp nháy
        self._generation += 1
        grid_id = self._topology_vm.selectedGridId
        job = (self._generation, copy.deepcopy(self._filter), grid_id, force)
        with self._job_lock:
            if self._busy:
                self._pending_job = job   # chỉ giữ job mới nhất
                return
            self._busy = True
        self._start_job(job)

    def _start_job(self, job):
        threading.Thread(target=self._run_job, args=job, daemon=True, name="analytics-live").start()

    def _compute(self, analytics_filter: AnalyticsFilter, grid_id: int) -> dict:
        """Chạy trên thread nền (cả lần miss lẫn refresh nền của cache) -> dùng calculator riêng, không chia sẻ state."""
        dataset = None
        for _ in range(_PENDING_ATTEMPTS):
            dataset = self._builder.build(analytics_filter, grid_id)
            if not dataset.get("pending"):
                break
            time.sleep(_PENDING_DELAY_S)
        calculated = AnalyticsCalculator().calculate(dataset)
        return {"calculated": calculated, "has_data": bool(dataset["samples"]), "stamp": time.time()}

    def _run_job(self, generation: int, analytics_filter: AnalyticsFilter, grid_id: int, force: bool):
        key = self._cache_key(analytics_filter, grid_id)
        try:
            if force:
                self._cache.invalidate(key)
            payload = self._cache.get(key, lambda: self._compute(analytics_filter, grid_id), None)
            if payload is None:
                payload = {"error": "Analytics refresh failed (see log)"}
        except Exception as exc:
            logger.exception("Analytics live build failed")
            payload = {"error": f"Analytics refresh failed: {exc}"}
        with self._job_lock:
            nxt, self._pending_job = self._pending_job, None
            if nxt is None:
                self._busy = False
        self._buildReady.emit(generation, payload)
        if nxt is not None:
            self._start_job(nxt)

    def _apply_result(self, generation: int, payload: dict):
        if generation != self._generation:
            return  # kết quả cũ: đã có yêu cầu mới hơn
        self._set_loading(False)
        if "error" in payload:
            self._set_error(payload["error"])
            return
        self._set_error("" if payload["has_data"] else "No historian data for the selected range (Influx power_rollup / rollup_daemon)")
        previous, self._last_payload = self._last_payload, payload
        if previous is not None and (previous is payload or previous["calculated"] == payload["calculated"]):
            return  # chưa có số liệu mới -> không publish lại, tránh QML vẽ lại toàn bộ chart
        self._publish(payload["calculated"], payload["has_data"])
